{
	"name": "coderx",
	"displayName": "coderX",
	"description": "An independent AI coding agent for VS Code that can edit files, run commands, use the browser, and work with your approval.",
	"version": "4.0.8",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "coderX"
	},
	"license": "Apache-2.0",
	"publisher": "coderx",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"coderx",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama"
	],
	"activationEvents": [
		"onView:coderx.SidebarProvider",
		"onUri"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "coderx-ActivityBar",
					"title": "coderX",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"coderx-ActivityBar": [
				{
					"type": "webview",
					"id": "coderx.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "coderx.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "coderx.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "coderx.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "coderx.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "coderx.addToChat",
				"title": "Add to coderX",
				"category": "coderX"
			},
			{
				"command": "coderx.addTerminalOutputToChat",
				"title": "Add to coderX",
				"category": "coderX"
			},
			{
				"command": "coderx.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "coderX"
			},
			{
				"command": "coderx.generateGitCommitMessage",
				"title": "Generate Commit Message with coderX",
				"category": "coderX",
				"icon": "$(sparkle)"
			},
			{
				"command": "coderx.abortGitCommitMessage",
				"title": "Generate Commit Message with coderX - Stop",
				"category": "coderX",
				"icon": "$(debug-stop)"
			},
			{
				"command": "coderx.explainCode",
				"title": "Explain with coderX",
				"category": "coderX"
			},
			{
				"command": "coderx.improveCode",
				"title": "Improve with coderX",
				"category": "coderX"
			},
			{
				"command": "coderx.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with coderX",
				"category": "coderX",
				"icon": "$(sparkle)"
			},
			{
				"command": "coderx.jupyterExplainCell",
				"title": "Explain Jupyter Cell with coderX",
				"category": "coderX",
				"icon": "$(question)"
			},
			{
				"command": "coderx.jupyterImproveCell",
				"title": "Improve Jupyter Cell with coderX",
				"category": "coderX",
				"icon": "$(lightbulb)"
			},
			{
				"command": "coderx.reconstructTaskHistory",
				"title": "Reconstruct Task History",
				"category": "coderX"
			},
			{
				"command": "coderx.reviewComment.reply",
				"title": "Reply",
				"category": "coderX",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "coderx.reviewComment.addToChat",
				"title": "Add to coderX Chat",
				"category": "coderX",
				"icon": "$(link-external)"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == coderx-ai-review && !commentIsEmpty"
			},
			{
				"command": "coderx.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "coderx.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == coderx.SidebarProvider"
				},
				{
					"command": "coderx.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == coderx.SidebarProvider"
				},
				{
					"command": "coderx.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == coderx.SidebarProvider"
				},
				{
					"command": "coderx.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == coderx.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "coderx.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "coderx.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "coderx.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !coderx.isGeneratingCommit"
				},
				{
					"command": "coderx.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && coderx.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "coderx.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "coderx.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "coderx.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "coderx.generateGitCommitMessage",
					"when": "config.git.enabled && !coderx.isGeneratingCommit"
				},
				{
					"command": "coderx.abortGitCommitMessage",
					"when": "config.git.enabled && coderx.isGeneratingCommit"
				},
				{
					"command": "coderx.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "coderx.reviewComment.reply",
					"group": "inline",
					"when": "commentController == coderx-ai-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "coderx.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == coderx-ai-review"
				}
			]
		},
		"configuration": {
			"title": "coderX",
			"properties": {}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npx npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run build:webview && npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/generated webview-ui/src/services/grpc-client.ts --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "npm run protos && tsc --noEmit && cd webview-ui && tsc --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"ci:check-all": "npx npm-run-all -p check-types lint format",
		"ci:build": "npm run protos && npm run build:webview && node esbuild.mjs && npm run compile-tests",
		"pretest": "npm run compile && npm run compile-tests && npm run lint",
		"test": "npx npm-run-all test:unit test:integration",
		"test:integration": "vscode-test",
		"test:unit": "cross-env TS_NODE_PROJECT=./tsconfig.unit-test.json mocha",
		"test:coverage": "vscode-test --coverage",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e:build": "vsce package --allow-package-secrets sendgrid --out dist/e2e.vsix",
		"test:e2e": "playwright install && npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "npx tsx scripts/interactive-playwright.ts",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"prepare": "npx husky",
		"docs": "cd docs && npm run dev",
		"docs:check-links": "cd docs && npm run check",
		"docs:rename-file": "cd docs && npm run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && npm run storybook",
		"eval:smoke:run": "npx tsx evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@bufbuild/buf": "^1.54.0",
		"@microsoft/tui-test": "0.0.1",
		"@playwright/test": "^1.55.1",
		"@types/chai": "^5.0.1",
		"@types/clone-deep": "^4.0.4",
		"@types/get-folder-size": "^3.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.7",
		"@types/node": "20.x",
		"@types/pdf-parse": "^1.1.4",
		"@types/picomatch": "^4.0.2",
		"@types/proxyquire": "^1.3.31",
		"@types/shell-quote": "^1.7.5",
		"@types/should": "^11.2.0",
		"@types/sinon": "^21.0.0",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "1.84.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.6.0",
		"c8": "^10.1.3",
		"chai": "^4.3.10",
		"chalk": "5.6.2",
		"cross-env": "^10.1.0",
		"dotenv": "^17.2.3",
		"esbuild": "^0.25.0",
		"grpc-tools": "^1.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.0",
		"minimatch": "^3.0.3",
		"npm-run-all": "^4.1.5",
		"nyc": "^17.1.0",
		"prebuild-install": "^7.1.3",
		"protoc-gen-ts": "^0.8.7",
		"proxyquire": "^2.1.3",
		"rimraf": "^6.0.1",
		"should": "^13.2.3",
		"sinon": "^21.0.3",
		"tree-kill": "^1.2.2",
		"ts-node": "^10.9.2",
		"ts-proto": "^2.6.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.50.4",
		"@anthropic-ai/vertex-sdk": "^0.11.5",
		"@aws-sdk/client-bedrock-runtime": "^3.922.0",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@azure/identity": "^4.13.0",
		"@bufbuild/protobuf": "^2.2.5",
		"@cerebras/cerebras_cloud_sdk": "^1.35.0",
		"@google-cloud/vertexai": "^1.9.3",
		"@google/genai": "^1.30.0",
		"@grpc/grpc-js": "^1.9.15",
		"@mistralai/mistralai": "^1.5.0",
		"@modelcontextprotocol/sdk": "^1.25.1",
		"@sap-ai-sdk/ai-api": "^2.7.0",
		"@sap-ai-sdk/orchestration": "^2.7.0",
		"@sap-cloud-sdk/connectivity": "^4.6.0",
		"@streamparser/json": "^0.0.22",
		"@vscode/codicons": "^0.0.36",
		"aws4fetch": "^1.0.20",
		"axios": "1.16.1",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"chrome-launcher": "^1.1.2",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"diff": "8.0.4",
		"exceljs": "^4.4.0",
		"execa": "^9.5.2",
		"fast-deep-equal": "^3.1.3",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"iconv-lite": "^0.6.3",
		"ignore": "^7.0.3",
		"image-size": "^2.0.2",
		"isbinaryfile": "^5.0.2",
		"jschardet": "^3.1.4",
		"json5": "^2.2.3",
		"mammoth": "^1.11.0",
		"nanoid": "^5.1.6",
		"node-machine-id": "^1.1.12",
		"ollama": "^0.5.13",
		"open": "^10.1.2",
		"open-graph-scraper": "^6.9.0",
		"openai": "^6.21.0",
		"os-name": "^6.0.0",
		"p-mutex": "^1.0.0",
		"p-timeout": "^6.1.4",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"picomatch": "^4.0.3",
		"puppeteer-chromium-resolver": "^23.0.0",
		"puppeteer-core": "^23.4.0",
		"reconnecting-eventsource": "^1.6.4",
		"serialize-error": "^11.0.3",
		"shell-quote": "^1.8.3",
		"simple-git": "3.36.0",
		"strip-ansi": "^7.1.2",
		"ts-morph": "^25.0.1",
		"turndown": "^7.2.0",
		"ulid": "^2.4.0",
		"undici": "^7.26.0",
		"uuid": "^11.1.0",
		"vscode-uri": "^3.1.0",
		"zod": "^3.24.2"
	},
	"overrides": {
		"tar-fs": ">=3.1.1",
		"tar": "^7.5.2",
		"vite": "^7.1.11",
		"js-yaml": "^4.1.1",
		"serialize-javascript": ">=7.0.3",
		"protobufjs": "7.5.8",
		"diff": "8.0.4"
	},
	"c8": {
		"reporter": [
			"lcov",
			"html"
		],
		"exclude": [
			"**/webview-ui/**",
			"**/.vscode-test/**",
			"**/node_modules/**",
			"node_modules",
			"**/*.d.ts",
			"**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
			"**/__tests__/**",
			"**/test/**",
			"**/tests/**",
			"**/.nyc_output/**",
			"**/tests-results/**",
			"src/test/**",
			"**/src/xml/**",
			"**/src/generated/**",
			"dist"
		],
		"all": true,
		"exclude-after-remap": true
	}
}
