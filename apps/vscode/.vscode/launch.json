{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (production)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-workspace-trust",
				"--disable-extension",
				"saoudrizwan.claude-dev",
				"--disable-extension",
				"saoudrizwan.cline-nightly",
				"${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "watch",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"IS_DEV": "true",
				"DEV_WORKSPACE_FOLDER": "${workspaceFolder}",
				"CLINE_ENVIRONMENT": "production"
			},
			"internalConsoleOptions": "openOnSessionStart"
		},
		{
			"name": "Run Extension (production, isolated)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-workspace-trust",
				"--disable-extensions",
				"${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "watch",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"IS_DEV": "true",
				"DEV_WORKSPACE_FOLDER": "${workspaceFolder}",
				"CLINE_ENVIRONMENT": "production"
			},
			"internalConsoleOptions": "openOnSessionStart"
		},
		{
			"name": "Run Extension (staging)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-workspace-trust",
				"--disable-extension",
				"saoudrizwan.claude-dev",
				"--disable-extension",
				"saoudrizwan.cline-nightly",
				"${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "watch",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"IS_DEV": "true",
				"DEV_WORKSPACE_FOLDER": "${workspaceFolder}",
				"CLINE_ENVIRONMENT": "staging"
			},
			"internalConsoleOptions": "openOnSessionStart"
		},
		{
			"name": "Run Extension (local)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-workspace-trust",
				"--disable-extension",
				"saoudrizwan.claude-dev",
				"--disable-extension",
				"saoudrizwan.cline-nightly",
				"${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "watch",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"IS_DEV": "true",
				"DEV_WORKSPACE_FOLDER": "${workspaceFolder}",
				"CLINE_ENVIRONMENT": "local"
			},
			"internalConsoleOptions": "openOnSessionStart"
		},
		{
			"name": "Run Extension (fresh install)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--user-data-dir=${workspaceFolder}/dist/tmp/user",
				"--profile-temp",
				"--sync=off",
				"--disable-extension",
				"saoudrizwan.claude-dev",
				"--disable-extension",
				"saoudrizwan.cline-nightly",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "clean-tmp-user",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"IS_DEV": "true",
				"TEMP_PROFILE": "true",
				"DEV_WORKSPACE_FOLDER": "${workspaceFolder}",
				"CLINE_ENVIRONMENT": "production"
			},
			"internalConsoleOptions": "openOnSessionStart"
		}
	]
}
